<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Pablo is dark-only, so day and night use the same dark launch.
         Android 12+ draws the adaptive icon centered on windowSplashScreenBackground. -->
    <style name="LaunchTheme" parent="@android:style/Theme.Black.NoTitleBar">
        <item name="android:windowBackground">@drawable/launch_background</item>
        <item name="android:windowSplashScreenBackground" tools:targetApi="31">@color/pablo_bg</item>
    </style>
    <!-- Behind the Flutter UI while it initializes. -->
    <style name="NormalTheme" parent="@android:style/Theme.Black.NoTitleBar">
        <item name="android:windowBackground">@color/pablo_bg</item>
    </style>
</resources>
